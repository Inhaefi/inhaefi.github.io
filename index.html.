.principles{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.principle{background:var(--panel);border:1px solid var(--line);border-radius:16px;padding:20px}.principle .emoji{font-size:1.8rem}.principle h3{margin:8px 0}.principle p{color:var(--muted);margin:0}
