function showRole(key){
 const d=roleData[key];
 detail.innerHTML=`<h3>${d.title}</h3><p class="sub">${d.sub}</p><p><strong>Contoh hero:</strong> ${d.heroes}</p><div class="tip-columns">${d.boxes.map(([title,items])=>`<div class="tip-box"><h4>${title}</h4><ul>${items.map(x=>`<li>${x}</li>`).join('')}</ul></div>`).join('')}</div>`;
 document.querySelectorAll('.role-tab').forEach(b=>b.classList.toggle('active',b.dataset.role===key));
}
document.querySelectorAll('.role-tab').forEach(b=>b.addEventListener('click',()=>showRole(b.dataset.role)));
showRole('exp');
const checks=[...document.querySelectorAll('#checkItems input')];
function updateProgress(){const n=checks.filter(c=>c.checked).length;const p=Math.round(n/checks.length*100);document.getElementById('progressNum').textContent=p+'%';document.getElementById('progressBar').style.width=p+'%';document.getElementById('progressText').textContent=p===100?'Mantap! Semua kebiasaan sudah ditandai.':`${n} dari ${checks.length} kebiasaan selesai.`}
checks.forEach(c=>c.addEventListener('change',updateProgress));
document.getElementById('resetCheck').addEventListener('click',()=>{checks.forEach(c=>c.checked=false);updateProgress()});
document.getElementById('tipSearch').addEventListener('input',e=>{const q=e.target.value.toLowerCase();let visible=0;document.querySelectorAll('.principle').forEach(card=>{const show=(card.innerText+' '+card.dataset.search).toLowerCase().includes(q);card.style.display=show?'':'none';if(show)visible++});document.getElementById('noResults').style.display=visible?'none':'block'});
document.getElementById('menuBtn').addEventListener('click',()=>document.getElementById('navlinks').classList.toggle('open'));
document.querySelectorAll('.navlinks a').forEach(a=>a.addEventListener('click',()=>document.getElementById('navlinks').classList.remove('open')));
</script>
</body>
</html>
