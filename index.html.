.practice{display:grid;grid-template-columns:repeat(7,1fr);gap:9px}.day{background:var(--panel);border:1px solid var(--line);border-radius:13px;padding:13px 9px;text-align:center}.day b{display:block;color:var(--gold)}.day small{color:var(--muted)}
.sources{color:var(--muted);font-size:.92rem}.sources a{color:var(--cyan);text-decoration:underline;text-underline-offset:3px}
footer{border-top:1px solid var(--line);margin-top:40px;padding:28px 0;color:var(--muted);font-size:.9rem}.foot{display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap}
.backtop{position:fixed;right:20px;bottom:20px;border-radius:50%;width:48px;height:48px;background:var(--gold);color:#17120a;border:0;font-size:1.2rem;font-weight:900;cursor:pointer;box-shadow:0 8px 25px #0008}
@media(max-width:900px){.role-grid{grid-template-columns:repeat(3,1fr)}.stats{grid-template-columns:repeat(2,1fr)}.practice{grid-template-columns:repeat(4,1fr)}}
